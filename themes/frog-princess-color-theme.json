    "modernEditorTab.hoverForeground": "#f2f6ec",
    "modernTab.activeBackground": "#356c53aa",
    "modernTab.activeForeground": "#f2f6ec",
    "modernTab.hoverBackground": "#162c23",
    "modernTab.hoverForeground": "#f2f6ec",
    "modernPanel.border": "#162c23",
    "modernUI.shellBackground": "#08110f",
    "terminalCursor.foreground": "#a8efc6",
    "terminal.selectionBackground": "#356c5399",
    "terminal.findMatchBackground": "#6ed89c55",
    "gitDecoration.modifiedResourceForeground": "#a8efc6",
    "gitDecoration.stageModifiedResourceForeground": "#a8efc6",
    "gitDecoration.untrackedResourceForeground": "#8ee6e6",
    "gitDecoration.addedResourceForeground": "#8ee6e6",
    "gitDecoration.renamedResourceForeground": "#8ee6e6",
    "gitDecoration.deletedResourceForeground": "#f08a9a",
    "gitDecoration.stageDeletedResourceForeground": "#f08a9a",
    "gitDecoration.conflictingResourceForeground": "#f08a9a",
    "gitDecoration.ignoredResourceForeground": "#416755",
    "gitDecoration.submoduleResourceForeground": "#a6b8ab",
