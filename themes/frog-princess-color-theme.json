    "sideBarTitle.foreground": "#a6b8ab",
    "sideBarSectionHeader.background": "#08110f",
    "sideBarSectionHeader.foreground": "#a6b8ab",
    "sideBarSectionHeader.border": "#162c23",
    "list.activeSelectionForeground": "#f2f6ec",
    "list.inactiveSelectionBackground": "#162c23",
    "list.inactiveSelectionForeground": "#dee6db",
    "list.hoverForeground": "#f2f6ec",
    "tree.indentGuidesStroke": "#2c5a45",
    "activityBar.inactiveForeground": "#8FAAA0",
