    "terminal.ansiBrightGreen": "#b4e2d9",
    "terminal.ansiYellow": "#e5c681",
    "terminal.ansiBrightYellow": "#edd7a7",
    "terminal.ansiBlue": "#83c9a0",
    "terminal.ansiBrightBlue": "#a8d9bd",
    "terminal.ansiMagenta": "#e7dab2",
    "terminal.ansiBrightMagenta": "#eee5c9",
    "terminal.ansiCyan": "#a6e3c0",
    "terminal.ansiBrightCyan": "#c1ebd3",
    "terminal.ansiWhite": "#d5dfd2",
    "terminal.ansiBrightWhite": "#e8eee2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7e9a92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#83c9a0"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#6CD199",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#E5C681"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#83c9a0"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#83c9a0"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#94d6c9"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#94d6c9"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#94d6c9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#d2e8a4"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E5C681",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E5C681"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e5c681",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#94d6c9",
    "method": "#94d6c9",
    "class": {
      "foreground": "#E5C681",
      "italic": true
    },
    "type": {
      "foreground": "#E5C681",
      "italic": true
    },
    "interface": {
      "foreground": "#E5C681",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#E5C681",
      "italic": true
    },
    "enum": {
      "foreground": "#E5C681",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e5c681",
      "italic": true
    },
    "property.declaration": "#e8eee2",
    "parameter": {
      "italic": true
    },
    "property": "#e8eee2"
  }
}
