    "terminal.ansiRed": "#f08a9a",
    "terminal.ansiBrightRed": "#f5adb8",
    "terminal.ansiGreen": "#8ee6e6",
    "terminal.ansiBrightGreen": "#b0eeee",
    "terminal.ansiYellow": "#edc977",
    "terminal.ansiBrightYellow": "#f2d9a0",
    "terminal.ansiBlue": "#6ed89c",
    "terminal.ansiBrightBlue": "#9ae4ba",
    "terminal.ansiMagenta": "#f0e0b2",
    "terminal.ansiBrightMagenta": "#f5e9c9",
    "terminal.ansiCyan": "#a8efc6",
    "terminal.ansiBrightCyan": "#c2f4d7",
    "terminal.ansiWhite": "#dee6db",
    "terminal.ansiBrightWhite": "#f2f6ec"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#86a59b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6ed89c"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#4FE391",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#EDC977"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6ed89c"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6ed89c"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#8ee6e6"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8ee6e6"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8ee6e6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#dff2a2"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#EDC977",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EDC977"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#edc977",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#8ee6e6",
    "method": "#8ee6e6",
    "class": {
      "foreground": "#EDC977",
      "italic": true
    },
    "type": {
      "foreground": "#EDC977",
      "italic": true
    },
    "interface": {
      "foreground": "#EDC977",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#EDC977",
      "italic": true
    },
    "enum": {
      "foreground": "#EDC977",
      "italic": true
    },
    "enumMember": {
      "foreground": "#edc977",
      "italic": true
    },
    "property.declaration": "#f2f6ec",
    "parameter": {
      "italic": true
    },
    "property": "#f2f6ec"
  }
}
