    "modernActivityBarItem.activeBackground": "#1E3D32",
    "modernActivityBarItem.hoverForeground": "#f2f6ec",
    "modernActivityBarItem.hoverBackground": "#162c23",
    "modernActivityBar.border": "#162c23",
    "modernEditorTab.activeBackground": "#0c1714",
